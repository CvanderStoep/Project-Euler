from math import prod
from mathlib.primes import prime_factors

k = 100000

radicals = {}
for n in range(1, k + 1):
    factors = prime_factors(n)
    radical = prod(set(factors))
    radicals[n] = radical

sorted_radicals = sorted(radicals.items(), key=lambda item: (item[1], item[0]))

element = 10000
print(f"The {element}-th element in the sorted radicals is: {sorted_radicals[element-1][0]}")
